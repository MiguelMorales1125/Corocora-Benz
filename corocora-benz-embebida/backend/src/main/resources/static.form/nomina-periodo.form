{
  "schemaVersion": 16,
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  },
  "executionPlatform": "Camunda Platform",
  "executionPlatformVersion": "7.24.0",
  "components": [
    {
      "label": "Periodo",
      "type": "textfield",
      "id": "Field_payPeriodId",
      "key": "payPeriodId",
      "description": "Ejemplo: 2026-11-Q2",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Ciclo de pago",
      "type": "select",
      "id": "Field_payCycle",
      "key": "payCycle",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Quincenal",
          "value": "QUINCENAL"
        },
        {
          "label": "Mensual",
          "value": "MENSUAL"
        }
      ]
    },
    {
      "label": "Fecha de corte de novedades",
      "type": "datetime",
      "id": "Field_cutoffDate",
      "key": "cutoffDate",
      "validate": {
        "required": true
      },
      "subtype": "date",
      "dateLabel": "Fecha de corte de novedades"
    }
  ],
  "type": "default",
  "id": "nomina-periodo"
}
