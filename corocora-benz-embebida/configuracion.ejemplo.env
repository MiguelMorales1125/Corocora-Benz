# Ejemplo de configuración de Corocora Benz.
#
# Para usarlo: copia este archivo como "configuracion.env" (en esta misma carpeta) y cambia
# los valores. iniciar-sistemas.bat e iniciar-sistemas.sh lo leen antes de arrancar y pasan
# cada variable a los seis sistemas. "configuracion.env" no se sube a git.
#
# Todo es opcional: sin este archivo cada sistema usa los valores que aparecen aquí.
# Formato: NOMBRE=valor, una variable por línea, sin comillas ni espacios alrededor del "=".

# --- PostgreSQL (no aplica si arrancas con el perfil h2) ---------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
# Base del motor Camunda y base de negocio de los demás sistemas (las crea crear-bases.sql).
DB_ENGINE_NAME=corocora_camunda
DB_NAME=corocora

# --- Integración entre sistemas ---------------------------------------------------------
# Credencial interna (encabezado X-CB-Internal). Debe ser la misma en los seis sistemas.
COROCORA_INTERNAL_TOKEN=cb-local-interno-demo
# Interfaz en la que escucha cada sistema. 127.0.0.1 = solo este equipo.
SERVER_ADDRESS=127.0.0.1
# Dónde encuentra cada sistema a los demás.
ENGINE_REST_URL=http://localhost:9000/engine-rest
PORTAL_TI_URL=http://localhost:9002
BANCO_URL=http://localhost:9004
TALLER_BODEGA_URL=http://localhost:9005

# --- Cuentas de demostración (las crea el motor al arrancar) ----------------------------
COROCORA_DEMO_IDENTIDADES=true
COROCORA_DEMO_PASSWORD=demo

# --- Notificaciones por correo ----------------------------------------------------------
# Con false, las notificaciones se escriben en el log del motor en lugar de enviarse.
CORREO_HABILITADO=false
MAIL_HOST=localhost
MAIL_PORT=1025

# --- Simuladores ------------------------------------------------------------------------
# true: el Banco y la Bodega responden solos a los pocos segundos.
# false: esperan la respuesta manual (API del Banco o panel de bodega de CentralSys).
BANCO_RESPUESTA_AUTOMATICA=true
BODEGA_RESPUESTA_AUTOMATICA=true
